# Application
APP_ENV=development
LOG_LEVEL=debug

# HTTP Server
SERVER_PORT=8080
SERVER_MODE=debug
SERVER_SHUTDOWN_TIMEOUT=10s

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=olympic_sport_db
POSTGRES_SSLMODE=disable
POSTGRES_MAX_CONNS=50
POSTGRES_MIN_CONNS=10
POSTGRES_MAX_CONN_IDLE_TIME=15m
POSTGRES_MAX_CONN_LIFETIME=1h

# Redis Cache & Fast Access Storage
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=100

# Security / JWT
JWT_SECRET=supersecretjwtkeyforolympicsports
JWT_EXPIRATION=24h

